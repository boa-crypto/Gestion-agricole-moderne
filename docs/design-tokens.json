      "duration-reveal": { "value": "620ms", "type": "other" },
      "ease-out": { "value": "cubic-bezier(.2, .7, .2, 1)", "type": "other" }
    },
    "grid": {
      "columns": { "value": "12", "type": "other" },
      "gutter": { "value": "32px", "type": "other" },
      "max-width": { "value": "1600px", "type": "other" }
    }
  }
